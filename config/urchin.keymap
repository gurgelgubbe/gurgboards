#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_se.h"

#define BASE 0
#define SYM  1
#define NAV  2
#define SET  3

&mt { flavor = "tap-preferred"; };

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            label = "base";
            bindings = <
&kp Q  &kp W  &kp F  &kp P  &kp B      &kp J  &kp L  &kp U  &kp Y      &kp SE_ARNG
&kp A  &kp R  &kp S  &kp T  &kp G      &kp M  &kp N  &kp E  &kp SE_ODIA &kp SE_ADIA
&kp Z  &kp X  &kp C  &kp D  &kp V      &kp K  &kp H  &kp O  &kp I      &kp SE_DOT
                              &none &none      &none &none
            >;
        };

        sym {
            label = "sym";
            bindings = <
&kp SE_EXLM &kp SE_DQUO &kp SE_HASH &kp SE_CURR &kp SE_PERC    &kp SE_AMPR &kp SE_SLSH &kp SE_LPRN &kp SE_RPRN &kp SE_EQL
&kp SE_PLUS &kp SE_MINS &kp SE_ASTR &kp SE_QUOT &kp SE_SCLN    &kp SE_COLN &kp SE_COMM &kp SE_DOT  &kp SE_UNDS &kp SE_QUES
&kp SE_AT   &kp SE_DLR  &kp SE_EUR  &kp SE_LBRC &kp SE_RBRC    &kp SE_LCBR &kp SE_RCBR &kp SE_BSLS &kp SE_PIPE &kp SE_TILD
                              &trans &trans      &trans &trans
            >;
        };

        nav {
            label = "nav";
            bindings = <
&kp ESC    &kp TAB       &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP   &kp PG_UP &kp HOME &kp UP    &kp END   &kp DEL
&kp LCTRL  &kp LALT      &kp LGUI   &kp LSHFT    &kp LSHFT      &kp BSPC  &kp LEFT &kp DOWN  &kp RIGHT &kp RET
&kp SE_ACUT &kp C_PREV   &kp C_PLAY_PAUSE &kp C_NEXT &kp CAPS   &kp INS   &none    &none     &none     &none
                              &trans &trans      &trans &trans
            >;
        };

        set {
            label = "set";
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR    &out OUT_TOG &studio_unlock &sys_reset &bootloader &none
&none &none &none &none &none    &none &none &none &none &none
&none &none &none &none &none    &none &none &none &none &none
                              &trans &trans      &trans &trans
            >;
        };
    };
};
