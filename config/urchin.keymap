#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_se.h"

#define baseLayer       0
#define symbolLayer     1
#define navLayer        2
#define functionLayer   3
#define bluetoothLayer  4

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp Q &kp W &kp F &kp P &kp B   &kp J &kp L &kp U &kp Y &kp SE_ARNG
&kp A &kp R &kp S &kp T &kp G   &kp M &kp N &kp E &kp SE_ODIA &kp SE_ADIA
&kp Z &kp X &kp C &kp D &kp V   &kp K &kp H &kp O &kp I &kp SE_DOT
                            &none &none   &none &none
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
&kp SE_EXLM &kp SE_DQUO &kp SE_HASH &kp SE_CURR &kp SE_PERC   &kp SE_AMPR &kp SE_SLSH &kp SE_LPRN &kp SE_RPRN &kp SE_EQL
&kp SE_PLUS &kp SE_MINS &kp SE_ASTR &kp SE_QUOT &kp SE_SCLN   &kp SE_COLN &kp SE_COMM &kp SE_DOT  &kp SE_UNDS &kp SE_QUES
&kp SE_AT   &kp SE_DLR  &kp SE_EUR  &kp SE_LBRC &kp SE_RBRC   &kp SE_LCBR &kp SE_RCBR &kp SE_BSLS &kp SE_PIPE &kp SE_TILD
                            &trans &trans   &trans &trans
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&kp ESC &kp TAB &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP   &kp PG_UP &kp HOME &kp UP    &kp END  &kp DELETE
&kp LCTRL &kp LALT &kp LGUI &kp LSHFT &kp SPACE        &kp BSPC  &kp LEFT &kp DOWN  &kp RIGHT &kp RET
&kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &kp C_PREV &kp C_PLAY_PAUSE &kp C_NEXT   &none &none &none &none &none
                            &trans &trans   &trans &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp F11 &kp F12 &none   &none   &none    &none   &none   &none   &none   &none
&none   &none   &none   &none   &none    &none   &none   &none   &none   &none
                            &trans &trans   &trans &trans
            >;
        };

        bt {
            display-name = "BT";
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR   &out OUT_TOG &sys_reset &bootloader &none &none
&none &none &none &none &none   &none &none &none &none &none
&none &none &none &none &none   &none &none &none &none &none
                            &trans &trans   &trans &trans
            >;
        };
    };
};
