#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keys_se.h"

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Swedish Colemak-DH";
            bindings = <
&kp ESC &kp N1 &kp N2 &kp N3  &kp N4  &kp N5 &kp N6  &kp N7  &kp N8 &kp N9 &kp N0 &kp BSPC
&kp TAB &kp Q &kp W &kp F   &kp P   &kp B &kp J   &kp L   &kp U &kp Y &kp SE_ARNG &kp DELETE
&kp LSHFT &kp A &kp R &kp S &kp T   &kp G &kp M   &kp N   &kp E &kp SE_ODIA &kp SE_ADIA &kp ENTER
&kp LCTRL &kp Z &kp X &kp C &kp D   &kp V &kp K   &kp H   &kp O &kp I &kp SE_DOT  &kp RCTRL
&kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp RALT &kp LALT &kp LGUI &kp SE_SLSH &kp SE_COMM &kp SE_MINS &kp SE_PLUS &kp LEFT &kp RIGHT
                                                                    &kp LSHFT &kp SPACE
            >;
        };
    };
};
